generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Office {
  id        String   @id @default(cuid())
  name      String
  address   String?
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id              String   @id @default(cuid())
  name            String
  sourceName      String?
  sourceUrl       String?  @unique
  address         String?
  latitude        Float?
  longitude       Float?
  locationQuality String   @default("unknown")
  gender          String   @default("unknown")
  priceAmount     Int?
  priceRaw        String?
  pricePeriod     String?
  isStartingPrice Boolean  @default(false)
  extraFeesNote   String?
  facilities      String   @default("[]")
  availability    String   @default("unknown")
  description     String?
  rawText         String?
  imageUrls       String   @default("[]")
  completeness       Float    @default(0)
  roomSizeM2         Float?
  depositAmount      Int?
  adminFee           Int?
  movingFee          Int?
  electricityStatus  String   @default("unknown")
  electricityMonthly Int?
  internetStatus     String   @default("unknown")
  internetMonthly    Int?
  laundryMonthly     Int?
  otherMonthly       Int?
  lastCheckedAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  priceHistory       PriceHistory[]
  favorite           Favorite?
  visit              VisitNote?
  nearby             NearbySnapshot?
}

model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  latitude  Float?
  longitude Float?
  label     String?
  fetchedAt DateTime @default(now())
}

model RouteCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  distanceMeters  Int
  durationSeconds Int
  geometry        String?
  provider        String   @default("osrm")
  fetchedAt       DateTime @default(now())
}

model PriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  amount     Int
  recordedAt DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  listingId String   @unique
  status    String   @default("saved")
  note      String?
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model VisitNote {
  id          String   @id @default(cuid())
  listingId   String   @unique
  checks      String   @default("{}")
  note        String?
  photoUrls   String   @default("[]")
  updatedAt   DateTime @updatedAt
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model NearbySnapshot {
  id        String   @id @default(cuid())
  listingId String   @unique
  payload   String
  fetchedAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id
  value String
}

model AiTurn {
  id         String   @id @default(cuid())
  scopeKey   String
  role       String
  content    String
  createdAt  DateTime @default(now())
}

model IsochroneCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  geojson   String
  fetchedAt DateTime @default(now())
}
